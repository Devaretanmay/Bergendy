{
  "name": "@boundary/nextjs",
  "version": "1.1.3",
  "description": "Boundary telemetry and contract testing for Next.js App Router and Edge Runtime",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./instrumentation": {
      "types": "./dist/instrumentation.d.ts",
      "import": "./dist/instrumentation.mjs",
      "require": "./dist/instrumentation.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.mjs",
      "require": "./dist/edge.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.js"
    }
  },
  "scripts": {
    "test": "node test/nextjs.test.mjs"
  },
  "keywords": [
    "boundary",
    "nextjs",
    "opentelemetry",
    "telemetry",
    "edge",
    "zod",
    "contract-testing"
  ],
  "author": "Boundary Authors",
  "license": "Apache-2.0",
  "peerDependencies": {
    "next": ">=13.4.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
